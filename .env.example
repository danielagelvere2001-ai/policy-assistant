# Copy this file to .env and fill in the values. Never commit .env.

# Google Gemini (free key: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_EMBED_DIM=768
# Keep model "thinking" low for speed. Gemini 3.x: minimal/low/medium/high. Gemini 2.5: budget 0.
GEMINI_THINKING_LEVEL=low
GEMINI_THINKING_BUDGET=0

# Shown on the comparison website
STUDENT_NAME=Daniela

# Slack bot (see README, "Slack bot setup")
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
# Which approach the bot uses: vector (default), llm or rules
BOT_APPROACH=vector
